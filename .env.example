# The gateway does not load this file: export the variables (docs/PUBLIC_DEPLOYMENT.md lists each).
HARNESS_ROOT=~/thesis/rambodambo          # the harness checkout (preview script, examples)
PUBLIC_PRIVATE_ORIGIN=http://127.0.0.1:8000
PUBLIC_ALLOWED_ORIGINS=
PUBLIC_ENV=production
PUBLIC_DEV_BYPASS=false
PUBLIC_TURNSTILE_ENABLED=true
PUBLIC_TRUST_CLIENT_ID=false
PUBLIC_SERVE_FRONTEND=false
PUBLIC_FRONTEND_DIR=                      # empty = web/dist of this repository
# Secrets: set in the shell or a secret store, never committed.
PUBLIC_IDENTITY_SALT=
TURNSTILE_SECRET_KEY=
# Public build values (visible to browsers).
VITE_PUBLIC_API_BASE=
VITE_TURNSTILE_SITE_KEY=
